@Metadata.layer: #CORE

  @UI.headerInfo: {
    typeName:       'Item',
    typeNamePlural: 'Items',
    title:          { value: 'Material' },
    description:    { value: 'ProcessItem' }
  }
annotate entity ZC_STO_ProcessItem with
{
  @UI.facet: [
    {
      id:       'ItemGeneral',
      type:     #COLLECTION,
      label:    'Item Details',
      position: 10
    },
    {
      id:            'ItemData',
      parentId:      'ItemGeneral',
      type:          #IDENTIFICATION_REFERENCE,
      label:         'General',
      position:      10
    },
    {
      id:            'Batches',
      type:          #LINEITEM_REFERENCE,
      label:         'Batch Splits',
      position:      20,
      targetElement: '_Batch'
    },
    {
      id:            'ItemTrace',
      type:          #LINEITEM_REFERENCE,
      label:         'Document Trace',
      position:      30,
      targetElement: '_ItemDoc'
    }
  ]


  @UI.lineItem:       [ { position: 5, importance: #HIGH, label: 'Item' } ]
  ProcessItem;

  @UI.lineItem:       [ { position: 10, importance: #HIGH } ]
  @UI.identification: [ { position: 10 } ]
  Material;

  @UI.lineItem:       [ { position: 20, importance: #HIGH } ]
  @UI.identification: [ { position: 20 } ]
  Quantity;

  @UI.lineItem:       [ { position: 30, importance: #HIGH } ]
  @UI.identification: [ { position: 30 } ]
  BaseUnit;

  @UI.hidden: true
  BatchAssignAllowed;

}